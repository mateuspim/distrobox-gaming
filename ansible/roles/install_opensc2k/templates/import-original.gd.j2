extends SceneTree

const SOURCE := {{ dg_opensc2k_original_exe | to_json }}
const ROOT := {{ dg_opensc2k_user_data | to_json }}


func _valid_pack(pack: String) -> bool:
    return (GameAssetSource.load_source("", "folder", pack.path_join("graphics")).error.is_empty()
        and MediaPack.load_folder(pack.path_join("sound"), "sound").error.is_empty()
        and MediaPack.load_folder(pack.path_join("music"), "music").error.is_empty()
        and DataPack.load_folder(pack.path_join("data")).error.is_empty())


func _initialize() -> void:
    var source_check := OriginalGameInstaller.validate_install_root(SOURCE.get_base_dir())
    if not source_check.ok:
        printerr(source_check.error)
        quit(1)
        return

    var settings := ROOT.path_join("settings.cfg")
    var config := ConfigFile.new()
    if FileAccess.file_exists(settings) and config.load(settings) != OK:
        printerr("Cannot read existing OpenSC2K settings")
        quit(1)
        return

    var configured := str(config.get_value("graphics", "folder", "")).get_base_dir()
    var paths_match := (str(config.get_value("graphics", "folder", "")) == configured.path_join("graphics")
        and str(config.get_value("audio", "sound_pack_folder", "")) == configured.path_join("sound")
        and str(config.get_value("audio", "music_pack_folder", "")) == configured.path_join("music")
        and str(config.get_value("data", "pack_folder", "")) == configured.path_join("data"))
    if config.get_value("graphics", "source", "") == "folder" and paths_match and _valid_pack(configured):
        print("OPENSC2K_CHANGED=false")
        quit(0)
        return

    var packs_root := ROOT.path_join("packs")
    if DirAccess.make_dir_recursive_absolute(packs_root) != OK:
        printerr("Cannot create OpenSC2K packs directory")
        quit(1)
        return
    var pack := ""
    for name in DirAccess.get_directories_at(packs_root):
        if name.begins_with("Original-SC2K-") and _valid_pack(packs_root.path_join(name)):
            pack = packs_root.path_join(name)
            break

    if pack.is_empty():
        var imported := OriginalPackImporter.import_executable(SOURCE, packs_root, ROOT)
        if not imported.ok:
            printerr(imported.error)
            quit(1)
            return
        pack = imported.graphics.get_base_dir().get_base_dir()
        if not _valid_pack(pack):
            printerr("Imported packs could not be loaded")
            quit(1)
            return

    config.set_value("graphics", "source", "folder")
    config.set_value("graphics", "folder", pack.path_join("graphics"))
    config.set_value("audio", "sound_pack_folder", pack.path_join("sound"))
    config.set_value("audio", "music_pack_folder", pack.path_join("music"))
    config.set_value("data", "pack_folder", pack.path_join("data"))
    if config.save(settings) != OK:
        printerr("Cannot save OpenSC2K settings")
        quit(1)
        return

    print("OPENSC2K_CHANGED=true")
    quit(0)
