#!/usr/bin/env sh
set -eu

install_dir="{{ dg_opencmr2_install_dir }}"
if [ ! -x "$install_dir/opencmr2" ]; then
  printf '%s\n' "OpenCMR2 is missing from $install_dir" >&2
  exit 1
fi

cd "$install_dir"
export LD_LIBRARY_PATH="$install_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$install_dir/opencmr2" --data "{{ dg_opencmr2_game_data }}" --user-dir "{{ dg_opencmr2_user_dir }}" "$@"
